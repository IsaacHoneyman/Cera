#!/bin/bash

# <===> WIP <===>

# =========================================================================
# Cera Unified CLI
# =========================================================================

COMPILER="./Compiler/Compiler.cs"
VM="./VirtualMachine"

show_help() {
    echo "Cera Functional Language CLI - 1.0"
    echo "Usage: cera <command> [flags] <file> [args...]"
    echo ""
    echo "Commands:"
    echo "  build       Compiles source to .cerabc"
    echo "  run         Executes a compiled Cera bytecode file"
    echo "  exec        Compiles and immediately executes the bytecode"
    echo "  dump        Compiles the file with all diagnostic dumps enabled"
    echo "  clean       Removes the Out/ build directories"
    echo "  make-vm     Rebuilds the CeraVM from source"
    echo "  help        Displays this help message"
    echo ""
    echo "Flags:"
    echo "  -v          Verbose output (Compiler & VM)"
    echo "  -q          Quiet output (VM only)"
    echo "  -f          File logging (VM only)"
    echo "  -t, -a, -m, -e, -D  Compiler diagnostic dumps"
}

if [ $# -lt 1 ]; then
    show_help
    exit 1
fi

COMMAND=$1
shift 1

FLAGS=()
FILE=""
PROGRAM_ARGS=()

# 1. Parse arguments dynamically based on position
while [[ $# -gt 0 ]]; do
    if [[ "$1" == -* && -z "$FILE" ]]; then
        # If it starts with a '-' and we haven't found the file yet, it's a flag
        FLAGS+=("$1")
        shift
    elif [[ -z "$FILE" ]]; then
        # The very first non-flag argument is strictly the file path
        FILE="$1"
        shift
    else
        # Everything after the file is treated as a program argument
        PROGRAM_ARGS+=("$1")
        shift
    fi
done

# 2. Route the arrays to the target executables
case $COMMAND in
    build)
        if [ -z "$FILE" ]; then
            echo "Error: 'build' requires a .cera file."
            exit 1
        fi
        $COMPILER "${FLAGS[@]}" "$FILE"
        ;;
        
    run)
        if [ -z "$FILE" ]; then
            echo "Error: 'run' requires a .cerabc file."
            exit 1
        fi
        $VM "${FLAGS[@]}" "$FILE" "${PROGRAM_ARGS[@]}"
        ;;
        
    exec)
        if [ -z "$FILE" ]; then
            echo "Error: 'exec' requires a .cera file."
            exit 1
        fi
        
        # Pass flags to the compiler
        $COMPILER "${FLAGS[@]}" "$FILE"
        COMPILE_STATUS=$?
        
        if [ $COMPILE_STATUS -eq 0 ]; then
            BASENAME=$(basename "$FILE" .cera)
            BYTECODE_PATH="Out/ByteCode/${BASENAME}.cerabc"
            
            if [ -f "$BYTECODE_PATH" ]; then
                # Pass flags and program arguments to the VM
                $VM "${FLAGS[@]}" "$BYTECODE_PATH" "${PROGRAM_ARGS[@]}"
            else
                echo "Error: Execution failed. Expected bytecode at $BYTECODE_PATH"
                exit 1
            fi
        else
            echo "Execution aborted due to compilation errors."
            exit $COMPILE_STATUS
        fi
        ;;
        
    dump)
        if [ -z "$FILE" ]; then
            echo "Error: 'dump' requires a .cera file."
            exit 1
        fi
        $COMPILER -D -t -a -m -e "${FLAGS[@]}" "$FILE"
        ;;
        
    clean)
        echo "Cleaning build directories..."
        rm -rf Out/ByteCode/ Out/Dump/ Out/VirtualMachine/
        echo "Clean complete."
        ;;
        
    make-vm)
        echo "Rebuilding CeraVM..."
        make -C ./ # Adjust this path to point to your C source directory
        echo "CeraVM build complete."
        ;;
        
    help)
        show_help
        ;;
        
    *)
        echo "Unknown command: $COMMAND"
        show_help
        exit 1
        ;;
esac