hidden import "Collection.cera";
hidden import "Time.cera";

/* 
    The offical IO libary for Cera.
    Offers support for expanded I/O functionality.
*/

// --- Strings ---

def strF(output: char list, insert: char list list) : char list = { 
    var cf = func(output: char list, insert: char list list) : char list = {
        var next: option<int> = findIndex(output, func(c: char) : bool = { c == '%'; });
        switch (next) {
            None -> output, // Base case: no more percentage signs found 
            Some(x) -> {
                var prevChar: option<char> = (x > 0) ? nth(output, x - 1) : None;
                switch (prevChar) {
                    Some('\\') -> {
                        concat(take(output, x - 1), concat("%", cf(skip(output, x + 1), insert)));
                    },
                    _ -> {
                        switch (insert) {
                            [] -> output, 
                            (h::tl) -> {                                
                                concat(take(output, x), concat(h, cf(skip(output, x + 1), tl)));
                            }
                        }
                    }
                }
            }
        }
    };
    cf(output, insert);
}

inline def substring(str: char list, start: int, len: int) : char list = {
    take(skip(str, start), len)
}

def split(str: char list, delimiter: char) : char list list = {
    var aux = func(rem: char list, currentWord: char list, acc: char list list) : char list list = { 
        switch (rem) {
            [] -> rev(rev(currentWord)::acc),
            (h::tl) ->
                if (h == delimiter) {
                    aux(tl, [], (rev(currentWord) :: acc));
                }
                else {
                    aux(tl, (h::currentWord), acc);
                }
        }
    };
    aux(str, [], []);
}

// --- Output ---

hidden def padLeft(val: int, targetLen: int, padChar: char) : char list = {
    var str = intToChars(val);
    var diff = targetLen - length(str);
    
    if (diff <= 0) { 
        str; 
    } else {
        var padding = build(diff, func(i: int) : char = padChar);
        concat(padding, str);
    }
}

inline def outN(output: char list) : unit = { out(output); out("\n"); }

inline def outF(output: char list, insert: char list list) : unit = { out(strF(output, insert)); }

inline def outFN(output: char list, insert: char list list) : unit = { outF(output, insert); outN(""); }

inline def outC() : unit = {
    out("\x1b[2J\x1b[H");
}

inline def outT(t: timeOnly) : unit = {
    var TimeOnly(h, m, s, ms) = t;
    outF("%:%:%.%", [padLeft(h, 2, '0'), padLeft(m, 2, '0'), padLeft(s, 2, '0'), intToChars(ms)]);
}

inline def outTN(t: timeOnly) : unit = { outT(t); outN(""); }

inline def outD(d: dateOnly) : unit = {
    var DateOnly(y, m, d) = d;
    outF("%-%-%", [padLeft(d, 2, '0'), padLeft(m, 2, '0'), intToChars(y)]);
}

inline def outDN(d: dateOnly) : unit = { outD(d); outN(""); }

inline def outDT(dt: dateTime) : unit = {
    var DateTime(d, t) = dt;
    outD(d); 
    out(" "); 
    outT(t); 
}

inline def outDTN(dt: dateTime) : unit = { outDT(dt); outN(""); }


// --- File ---

def readD(path: char list) : char list = {
    switch (read(path)) {
        Ok(content) -> content,
        Error(err) -> {
            outFN("FATAL I/O: Failed to read. %", [err]);
            []; // Fallback empty list
        }
    }
}

def writeD(path: char list, content: char list) : unit = {
    switch (write(path, content)) {
        Ok(u) -> (),
        Error(err) -> {
            outFN("FATAL I/O: Failed to write. %", [err]);
            (); // Fallback unit 
        }
    }
}

def appendD(path: char list, content: char list) : unit = {
    switch (append(path, content)) {
        Ok(u) -> (),
        Error(err) -> {
            outFN("FATAL I/O: Failed to append. %", [err]);
            (); // Fallback unit
        }
    }
}