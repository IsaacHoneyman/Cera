// --- Keypad (Numpad) ---
var keyKpDivide: int = 84;
var keyKpMultiply: int = 85;
var keyKpMinus: int = 86;
var keyKpPlus: int = 87;
var keyKpEnter: int = 88;
var keyKp1: int = 89;
