var keyEsc: int = 41;        // Escape
var keyBackspace: int = 42;
var keyTab: int = 43;
var keySpace: int = 44;

// --- Symbols & Punctuation ---
var keyMinus: int = 45;      // -
var keyEquals: int = 46;     // =
var keyLBracket: int = 47;   // [
var keyRBracket: int = 48;   // ]
var keyBackslash: int = 49;  // \
var keySemicolon: int = 51;  // ;
var keyApostrophe: int = 52; // '
var keyGrave: int = 53;      // `
var keyComma: int = 54;      // ,
var keyPeriod: int = 55;     // .
var keySlash: int = 56;      // /

// --- Function Keys ---
var keyF1: int = 58;
var keyF2: int = 59;
var keyF3: int = 60;
var keyF4: int = 61;
var keyF5: int = 62;
var keyF6: int = 63;
var keyF7: int = 64;
var keyF8: int = 65;
var keyF9: int = 66;
var keyF10: int = 67;
