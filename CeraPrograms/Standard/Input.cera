/*
    The offical libary for input in Cera.
    Offers suport for realtime mouse and 
    keyboard input.
*/

hidden extern def extGetKey(code: int) : int = "cera_window";
hidden extern def extGetKeyDown(code: int) : int = "cera_window";
hidden extern def extGetKeyUp(code: int) : int = "cera_window";

hidden extern def extGetMouseX() : int = "cera_window";
hidden extern def extGetMouseY() : int = "cera_window";
hidden extern def extGetMouseButton(btn: int) : int = "cera_window";
hidden extern def extGetMouseButtonDown(btn: int) : int = "cera_window";

// --- Keyboard API ---

// True as long as the key is held down
inline def getKey(code: int) : bool = { extGetKey(code) == 1 }

// True ONLY on the exact frame the key was pressed
inline def getKeyDown(code: int) : bool = { extGetKeyDown(code) == 1 }

// True ONLY on the exact frame the key was released
inline def getKeyUp(code: int) : bool = { extGetKeyUp(code) == 1 }

inline def getMouseX() : int = { extGetMouseX() }
inline def getMouseY() : int = { extGetMouseY() }
inline def getMouseBtn(btn: int) : bool = { extGetMouseButton(btn) == 1 }
inline def getMouseBtnDown(btn: int) : bool = { extGetMouseButtonDown(btn) == 1 }

// ==========================================
// --- Key Constants (SDL Scancodes) ---
// ==========================================

// --- Alphabet ---
var keyA: int = 4;
var keyB: int = 5;
var keyC: int = 6;
var keyD: int = 7;
var keyE: int = 8;
var keyF: int = 9;
var keyG: int = 10;
var keyH: int = 11;
var keyI: int = 12;
var keyJ: int = 13;
var keyK: int = 14;
var keyL: int = 15;
var keyM: int = 16;
var keyN: int = 17;
var keyO: int = 18;
var keyP: int = 19;
var keyQ: int = 20;
var keyR: int = 21;
var keyS: int = 22;
var keyT: int = 23;
var keyU: int = 24;
var keyV: int = 25;
var keyW: int = 26;
