/* 
    The offical math libary for Cera.
    Offers support for basic mathematical operations for 
    both int and float types.
*/

// --- Constants ---

def pi() : float = { 3.14159265358979 }
def e() : float = { 2.71828182845905 }

// --- Functions ---

def round(x : float) : float = {
    intToFloat(roundToInt(x))
}

def roundToInt(x : float) : int = {
    if (x >= 0.0) { floatToInt(x + 0.5) }
    else { floatToInt(x - 0.5) }
}

def min(x: float, y: float) : float = { x <= y ? x : y }
def minInt(x: int, y: int) : int = { x <= y ? x : y }
def max(x: float, y: float) : float = { x <= y ? y : x }
def maxInt(x : int, y : int) : int = {  x <= y ? y : x }
def abs(x : float) : float = { x >= 0.0 ? x : -x }
def absInt(x : int) : int = { x >= 0 ? x : -x }

def floor(x : float) : float = {
    var trunc: float = intToFloat(floatToInt(x));
    (x < 0.0 && x != trunc) ? trunc - 1.0 : trunc 
}

def ceil(x: float) : float = {
    var trunc: float = intToFloat(floatToInt(x));
    (x > 0.0 && x != trunc) ? trunc + 1.0 : trunc 
}

def randRange(min: float, max: float) : float = {
    min + (rand() * (max - min));
} 

def randRangeInt(min: int, max: int) : int = {
    var diff: int = (max - min) + 1;
    min + absInt(randInt() % diff);
}

def pow(base: float, exp: int) : float = {
    if (exp <= 0) { 1.0; } 
    else { base * pow(base, exp - 1); }
}

def lessThan<g>(cmp: (g * g) -> int, value: g) : g -> bool = {
    func(x: g) : bool = { cmp(x, value) < 0; }
}

def lessThanEqual<g>(cmp: (g * g) -> int, value: g) : g -> bool = {
    func(x: g) : bool = { cmp(x, value) <= 0; }
}

def moreThan<g>(cmp: (g * g) -> int, value: g) : g -> bool = {
    func(x: g) : bool = { cmp(x, value) > 0; }
}

def moreThanEqual<g>(cmp: (g * g) -> int, value: g) : g -> bool = {
    func(x: g) : bool = { cmp(x, value) >= 0; }
}

def factorial(n: int) : int = {
    if (n <= 1) { 1; }
    else { n * factorial(n - 1); }
}