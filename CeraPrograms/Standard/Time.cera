/* 
    The offical time libary for Cera.
    Offers support for basic time related
    operations and manipulation.
*/

// --- Basic Utility ---

inline def timeSeconds() : int = { msInSeconds(time()) }
inline def localTimeSeconds() : int = { msInSeconds(timeLocal())}
inline def uptimeSeconds() : int = { msInSeconds(uptime()) }

// --- Constants ---

hidden var msPerDay: int = 86400000;
hidden var msPerHour: int = 3600000;
hidden var msPerMinute: int = 60000;
hidden var msPerSecond: int = 1000;

inline def daysInMs(days : int) : int = { days * msPerDay }
inline def hoursInMs(hours : int) : int = { hours * msPerHour } 
inline def minutesInMs(minutes : int) : int = { minutes * msPerMinute }
inline def secondsInMs(seconds: int) : int = { seconds * msPerSecond } 

inline def timeInMs(t: timeOnly) : int = {
    var TimeOnly(h, m, s, ms) = t;
    hoursInMs(h) + minutesInMs(m) + secondsInMs(s) + ms;
}

inline def dateInMs(d: dateOnly) : int = {
    var DateOnly(y, m, dNum) = d;
    var totalDays = daysFrom1970(y) + daysInMonths(daysInMonth(y), m) + (dNum - 1);
    daysInMs(totalDays);
}

inline def dateTimeInMs(dt: dateTime) : int = {
    var DateTime(d, t) = dt;
    dateInMs(d) + timeInMs(t);
}

inline def msInDays(ms: int) : int = { ms / msPerDay }
inline def msInHours(ms: int) : int = { ms / msPerHour }
inline def msInMinutes(ms: int) : int = { ms / msPerMinute }
inline def msInSeconds(ms: int) : int = { ms / msPerSecond }

hidden inline def daysInMonth(year: int) : int list = {
    [31, isLeapYear(year) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
}

hidden inline def isLeapYear(year : int) : bool = {
    ((year % 4 == 0) && (year % 100 != 0)) || (year % 400 == 0);
}

hidden def getYear(year: int, day: int) : (int * int) = {
    var daysInYear = isLeapYear(year) ? 366 : 365;
    if (day >= daysInYear) { getYear(year + 1, day - daysInYear ) }
    else { (year, day) }
}

hidden def getMonth(daysList: int list, currentMonth: int, day: int) : (int * int) = {
    switch(daysList) {
        [] -> (currentMonth, day + 1),
        (days::tail) if (day >= days) -> getMonth(tail, currentMonth + 1, day - days),
        _ -> (currentMonth, day + 1)
    }
}

hidden def daysFrom1970(year: int, currentYear: int = 1970, acc: int = 0) : int = {
    if (currentYear >= year) { 
        acc; 
    } else {
        var days = isLeapYear(currentYear) ? 366 : 365;
        daysFrom1970(year, currentYear + 1, acc + days);
    }
}

hidden def daysInMonths(months: int list, targetMonth: int, currentMonth: int = 1, acc: int = 0) : int = {
    switch (months) {
        [] -> acc,
        (days::tl) ->
            if (currentMonth >= targetMonth) { 
                acc; 
            } else { 
                daysInMonths(tl, targetMonth, currentMonth + 1, acc + days) 
            }
    }
}

// --- Date Time ---

type timeOnly = TimeOnly: (int * int * int * int); // hour, minute, second, millisecond
type dateOnly = DateOnly: (int * int * int); // year, month, day 
type dateTime = DateTime: (dateOnly * timeOnly);

def buildTime(ms: int) : timeOnly = {
    var hours = msInHours(ms);
    var minutes = msInMinutes(ms - hoursInMs(hours));
    var seconds = msInSeconds(ms - hoursInMs(hours) - minutesInMs(minutes));
    TimeOnly(hours % 24, minutes, seconds,
        ms - hoursInMs(hours) - minutesInMs(minutes) - secondsInMs(seconds))
}

def buildDate(ms: int) : dateOnly = {
    var totalDays = msInDays(ms);    
    var (year, remainingDays) = getYear(1970, totalDays);
    var monthList = daysInMonth(year);    
    var (month, day) = getMonth(monthList, 1, remainingDays);
    
    DateOnly(year, month, day);
}

inline def buildDateTime(ms: int) : dateTime = {
    DateTime(buildDate(ms), buildTime(ms));
}

// --- Arithmetic ---

inline def diffTime(t1: timeOnly, t2: timeOnly) : int = {
    timeInMs(t1) - timeInMs(t2);
}

inline def diffDate(d1: dateOnly, d2: dateOnly) : int = {
    dateInMs(d1) - dateInMs(d2);
}

inline def diffDateTime(dt1: dateTime, dt2: dateTime) : int = {
    dateTimeInMs(dt1) - dateTimeInMs(dt2);
}

inline def addDays(d: dateOnly, days: int) : dateOnly = {
    buildDate(dateInMs(d) + daysInMs(days));
}

inline def addHours(dt: dateTime, hours: int) : dateTime = {
    buildDateTime(dateTimeInMs(dt) + hoursInMs(hours));
}

inline def addMinutes(dt: dateTime, mins: int) : dateTime = {
    buildDateTime(dateTimeInMs(dt) + minutesInMs(mins));
}