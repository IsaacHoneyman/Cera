import "Math.cera";
import "IO.cera";
import "Collection.cera";

def entry(args: char list arr) : int = {
    outC();
    outN("--- Cera Number Game ---\nPlay [p], Quit [q]");
    outN(arrMem(args, "-h") ? "Hard Mode" : "Normal Mode");

    var inp = in();

    if (inp == "q" || inp == "Q") { 
        0; 
    }
    else {
        play(0, 3, arrMem(args, "-h"));
        entry(args);
    }
}

def play(score: int, lives: int, hard: bool) : unit = {
    if (lives == 0) {
        outFN("Game Over, Final Score: %", [intToChars(score)]);
        outN("Press Enter To Continue...");
        in();
        ();
    }
    else {
        outFN("Current Score: %, Lives: %", [intToChars(score), intToChars(lives)]);
        var x = randRangeInt(1, hard ? 14 : 10);
        var y = randRangeInt(1, hard ? 14 : 10);
        var op = randRangeInt(0, 2);
        outN(getOpStr(x, y, op));
        var a = charsToInt(in());
        
        var handleFail = func(u: unit) : unit = {
            outN("Incorrect");
            play(score, lives - 1, hard);
        };
        
        switch (a) {
            None -> handleFail(()),
            Some(z) ->
                if (z == getOpResult(x, y, op)) {
                    outN("Correct");
                    play(score + 1, lives, hard)
                }
                else {
                    handleFail(())
                }
        }
    }
}


def getOpStr(x: int, y: int, op: int) : char list = {
    var xC : char list = intToChars(x);
    var yC : char list = intToChars(y);
    switch (op) {
        0 -> strF("% + %", [xC, yC]),
        1 -> strF("% - %", [xC, yC]),
        2 -> strF("% * %", [xC, yC])
    }
}

def getOpResult(x: int, y: int, op: int) : int = {
    switch (op) {
        0 -> x + y,
        1 -> x - y,
        2 -> x * y
    }
}