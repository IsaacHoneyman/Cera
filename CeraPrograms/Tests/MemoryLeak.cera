// MemoryLeakTest.cera

def forceStackLeak(iterations: int) : unit = {
    if (iterations <= 0) {
        ();
    } else {
        // Initialize a minimal single-element list
        var dummyList: int list = [42];
        
        switch (dummyList) {
            // Base case fallback
            [] -> (),
            
            // The compiler pushes '42' and the empty tail '[]' to the stack.
            // 'tl' binds to '[]', but '_' causes '42' to be ignored.
            // With no OP_POP emitted, '42' is abandoned on the stack.
            (_::tl) -> forceStackLeak(iterations - 1) 
        }
    }
}

def entry(args: char list arr) : int = {
    // 50,000 iterations will deposit 50,000 dead integers onto the operand 
    // stack, aggressively triggering the VM crash.
    forceStackLeak(50000);
    
    0;
}