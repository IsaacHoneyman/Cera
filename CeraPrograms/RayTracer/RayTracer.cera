hidden import "Scene.cera";
hidden import "Renderer.cera";
hidden import "IO.cera";

inline def parseArg(args: char list arr, index: int, defaultVal: int) : int = {
    switch (get(args, index)) {
        None -> defaultVal, 
        Some(str) -> {
            switch (charsToInt(str)) {
                None -> defaultVal, 
                Some(val) -> val   
            }
        }
    }
}

def entry(args: char list arr) : int = {
    var width: int = parseArg(args, 1, 200);
    var height: int = parseArg(args, 2, 100);
    var hWidth : float = intToFloat(width) / 2.0;
    var hHeight : float = intToFloat(height) / 2.0;
    var depth: int = parseArg(args, 3, 3); 
    var shadowSamples: int = parseArg(args, 4, 8); 
    var aaSamples: int = parseArg(args, 5, 4);   

    var startTime: int = uptime(); 
    
    outFN("Starting render with dimensions: %x% | Depth: % | Shadow Samples: % | AA Samples: %", 
        [intToChars(width), intToChars(height), intToChars(depth), intToChars(shadowSamples), intToChars(aaSamples)]);
    
    var header: char list = strF("P3\n% %\n255\n", [intToChars(width), intToChars(height)]);
    var scn: scene = getScene();
        
    switch (write("Out/image.ppm", header)) {
        Error(err) -> {
            outFN("Fatal I/O Error writing header: %", [err]);
            1; // Return failure code
        },
        Ok(u) -> {
            renderScreen(0, width, height, hWidth, hHeight, depth, shadowSamples, aaSamples, scn);
            
            var endTime = uptime();
            outFN("Render completed in % seconds (%ms)", [intToChars((endTime - startTime) / 1000), intToChars(endTime - startTime)]);
            outN("Render successfully saved to Out/image.ppm!");
            
            0; // Return success code
        }
    }

    
}