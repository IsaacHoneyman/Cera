type element = 
    Air | Sand: int;

inline def getElementColour(elm: element) : int = {
    switch (elm) {
        Air -> getColour(52, 161, 235),
        Sand(x) if (x == 0) -> getColour(199, 189, 76),
        Sand(x) -> getColour(191, 184, 109),
        _ -> getColour(255, 0, 0)
    }
}

hidden inline def getColour(r: int, g: int, b: int) : int = {
    (255 << 24) | (r << 16) | (g << 8) | b;
}