hidden import "Math.cera";
hidden import "Element.cera";
hidden import "Collection.cera";

var simWidth = 320;
var simHeight = 200;

def updateCell(i: int, map: element arr, mx: int, my: int, leftDown: bool, rightDown: bool) : element = {
    var x = i % simWidth;
    var y = i / simWidth;

    if (leftDown && absInt(x - mx) < 8 && absInt(y - my) < 8) {
        Sand(x % 2);
    } else if (rightDown && absInt(x - mx) < 8 && absInt(y - my) < 8) {
        Air;
    }
    else {
        getD(map, i, Air);
    }
}