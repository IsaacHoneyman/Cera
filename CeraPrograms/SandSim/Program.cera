hidden import "Window.cera";
hidden import "Input.cera";
hidden import "Element.cera";
hidden import "Collection.cera";
hidden import "Physics.cera";

hidden var scale = 3;

hidden def draw(win: window, map: element arr) : unit = {
    var pc = simWidth * simHeight;
    var pixels: int arr = arrBuild(pc, func(i: int) : int = { getElementColour(getD(map, i, Air)); });
    drawPixels(win, pixels, simWidth, simHeight);
}

hidden def renderLoop(win: window, map: element arr) : unit = {
    if (!pollEvents(win)) {
        var mx = getMouseX() / scale;
        var my = getMouseY() / scale;
        
        var leftClick = getMouseBtn(mouseLeft);
        var rightClick = getMouseBtn(mouseRight);

        var nextMap: element arr = arrBuild(simWidth * simHeight, 
            func(i: int) : element = updateCell(i, map, mx, my, leftClick, rightClick)
        );

        draw(win, nextMap);
        renderLoop(win, nextMap);
    }
}

def entry(args: char list arr) : int = {
    var win = createWindow("Cera Sand Sim", simWidth * scale, simHeight * scale, simWidth, simHeight);
    var initMap: element arr = arrBuild(simWidth * simHeight, func(i: int) : element = Air);
    renderLoop(win, initMap);

    0;
}