hidden import "IO.cera";
hidden import "Parser.cera";

/*  Test suite for the lexer and parser */

def runLexerTests() : unit = {
    outN("\n--- Lexer Tests ---");

    // expected to match
    runTest("5", [Num(5.0, "5"), EOF]);
    runTest("0", [Num(0.0, "0"), EOF]);
    runTest("0.5", [Num(0.5, "0.5"), EOF]);
    runTest(".5", [Num(0.5, ".5"), EOF]);
    runTest("5.", [Num(5.0, "5."), EOF]);
    runTest("3.14", [Num(3.14, "3.14"), EOF]);
    runTest("1e5", [Num(100000.0, "1e5"), EOF]);
    runTest("1e+5", [Num(100000.0, "1e+5"), EOF]);
    runTest("1e-5", [Num(0.00001, "1e-5"), EOF]);
    runTest("1e0", [Num(1.0, "1e0"), EOF]);
    runTest("2.3+4", [Num(2.3, "2.3"), Plus, Num(4.0, "4"), EOF]);
    runTest("cos 2 ^ 3!", [Cos, Num(2.0, "2"), Pow, Num(3.0, "3"), Fact, EOF]);
    runTest("2--3", [Num(2.0, "2"), Minus, Minus, Num(3.0, "3"), EOF]);
    runTest("", [EOF]);

    // expected to error
    runTest("007");
    runTest("1E5");
    runTest("1e");
    runTest("1e+");
    runTest("1e05");
    runTest("2.3.4");
    runTest(".");
    runTest("1e5.0");
    runTest("1e2e3");
    runTest("co");
    runTest("x");
    runTest("@");
} 

hidden def runTest(input: char list, expected: tokenType list = []) : unit = {
    var (outPass, outFail) = (
        func() : unit = outFN("Test passed - input '%'", [input]), 
        func(lexed: result<token list, char list>) : unit = {
            outFN("Test failed - input '%'", [input]);
            switch (lexed) {
                Error(e) -> outFN("Got %", [e]),
                Ok(found) -> outTestComparision(found, expected)
            }
        }
    );
    
    var lexed = lex(input);
    switch (lexed) {
        Error(_) if (expected == []) -> outPass(),
        Error(_) -> outFail(lexed),
        Ok(_) if (expected == []) -> outFail(lexed),
        Ok(found) -> {
            if (verifyTestResults(found, expected)) { outPass(); }
            else { outFail(lexed); } 
        }
    }
}

hidden def outTestComparision(found: token list, expected: tokenType list) : unit = {    
    switch ((found, expected)) {
        ([], []) -> (),
        ([], (h::tl)) -> {
            outFN("None vs %", [strTType(h)]);
            outTestComparision([], tl);
        },
        ((h::tl), []) -> {
            var Token(tType, _) = h;
            outFN("% vs None", [strTType(tType)]);
            outTestComparision(tl, []);
        },
        ((h1::tl1), (h2::tl2)) -> {
            var Token(tType, _) = h1;
            outFN("% vs %", [strTType(tType), strTType(h2)]);
            outTestComparision(tl1, tl2);
        }
    }
}


hidden def verifyTestResults(found: token list, expected: tokenType list) : bool = {
    switch ((found, expected)) {
        ([], []) -> true,
        ([], _) -> false,
        (_, []) -> false,
        ((h1::tl1), (h2::tl2)) -> {
            var Token(tType1, _) = h1;
            if (tType1 == h2) { verifyTestResults(tl1, tl2) }
            else { false; }
        }
    }
}

// --- Parser ---

def runParserTests() : unit = {
    outN("\n--- Parser Tests ---");

    // literals
    runPTest("5", "5");
    runPTest("-3", "-3");
    runPTest("+5", "+5");

    // associativity
    runPTest("1+2", "(+ 1 2)");
    runPTest("1+2+3", "(+ (+ 1 2) 3)");       // + left associative
    runPTest("1-2-3", "(- (- 1 2) 3)");       // - left associative
    runPTest("2^3", "(^ 2 3)");
    runPTest("2^3^2", "(^ 2 (^ 3 2))");       // ^ right associative

    // precedence
    runPTest("1+2-3", "(+ 1 (- 2 3))");       // - binds tighter than +
    runPTest("1+2^3-4", "(+ 1 (- (^ 2 3) 4))");
    runPTest("cos 2 ^ 3", "(^ (cos 2) 3)");   // cos binds tighter than ^
    runPTest("2^3!", "(^ 2 (! 3))");          // ! tightest
    runPTest("cos 3!", "(cos (! 3))");

    // stacking
    runPTest("cos cos 2", "(cos (cos 2))");
    runPTest("3!!", "(! (! 3))");

    // the sign is a grammar production, not part of the literal
    runPTest("2--3", "(- 2 -3)");

    // expected to error
    runPTest("2+");
    runPTest("+");
    runPTest("^3");
    runPTest("2 3");
    runPTest("!");
    runPTest("cos");
}

hidden def runPTest(input: char list, expected: char list = "") : unit = {
    switch (lex(input)) {
        Error(e) ->
            if (expected == "") { outFN("Test passed - input '%' (lexer rejected)", [input]) }
            else { outFN("Test FAILED - input '%' - lexer gave %", [input, e]) },

        Ok(toks) -> switch (parse(toks)) {
            Error(e) ->
                if (expected == "") { outFN("Test passed - input '%' (parser rejected)", [input]) }
                else { outFN("Test FAILED - input '%' - parser gave %", [input, e]) },

            Ok(tree) -> {
                var found = strTree(tree);
                if (expected == "") {
                    outFN("Test FAILED - input '%' - expected rejection, parsed as %", [input, found]);
                }
                else if (found == expected) { outFN("Test passed - input '%'", [input]); }
                else { outFN("Test FAILED - input '%' - expected %, got %", [input, expected, found]); }
            }
        }
    }
}

// Renders a parse tree as a prefix expression, collapsing chain reductions.
hidden def strTree(t: parseTree) : char list = {
    switch (t) {
        Leaf(tok) -> {
            var Token(tType, _) = tok;
            symOf(tType)
        },
        Node(nt, kids) -> switch (kids) {
            (a::[]) -> strTree(a),
            (a::(b::[])) -> strTwo(nt, a, b),
            (a::(b::(c::[]))) -> strF("(% % %)", [strTree(b), strTree(a), strTree(c)]),
            _ -> "<unexpected node arity>"
        }
    }
}

hidden def strTwo(nt: nonTerminal, a: parseTree, b: parseTree) : char list = {
    switch (nt) {
        PrefixNT -> strF("(cos %)", [strTree(b)]),
        PostfixNT -> strF("(! %)", [strTree(a)]),
        LitNT -> concat(strTree(a), strTree(b)),
        _ -> "<unexpected node>"
    }
}

hidden def symOf(t: tokenType) : char list = {
    switch (t) {
        Num(_, raw) -> raw,
        Plus -> "+",
        Minus -> "-",
        Pow -> "^",
        Cos -> "cos",
        Fact -> "!",
        EOF -> "EOF"
    }
}