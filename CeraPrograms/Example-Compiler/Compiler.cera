hidden import "IO.cera";
hidden import "Parser.cera";
hidden import "Test.cera";

def entry(args: char list arr) : int = { 
    outC();
    outN("--- Cera Compiler Example ---");
    runCompiler();
    
    0
}

hidden def runCompiler() : unit = {
    var input = getInput();
    
    if (input == "q") { () } 
    else if (input == "t") {
        runLexerTests();
        runParserTests();
        runCompiler();
    }
    else {
        switch (lex(input)) {
            Error(e) -> {
                outN(e);
                runCompiler();
            },
            Ok(t) -> {
                outN("Lexer complete.");
                outLex(t);
                runParser(t);
                runCompiler();
            }
        }
    }
}

hidden def runParser(tokens: token list) : unit = {
    switch (parse(tokens)) {
        Error(e) -> outN(e),
        Ok(tree) -> {
            outN("Parser complete.");
            outTree(tree)
        }
    }
}

hidden inline def getInput() : char list = {
    out("\nInput string to be lexed and parsed: ");
    in()
}