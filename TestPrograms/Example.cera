/*
  Cera Lexer Test Suite
  Validates block comments, whitespace consumption, and token generation.
*/

// 1. Custom Types (Tests keywords, PascalCase constructors, and the '|' operator)
type tree<g> = Leaf | Node: g * tree<g> * tree<g>;

// 2. Pattern Matching & Generics (Tests '->', '<', '>', and '::')
def mapList<a, b>(f: a -> b, lst: a list): b list = {
    switch (lst) {
        [] -> [],
        (head::tail) -> f(head) :: mapList(f, tail)
    };
}

// 3. Entry Point (Tests literals, shadowing, and multi-character operators)
def entry(args: char list arr): int = {
    // Basic bindings and primitive literals
    var baseValue: int = 10;
    var multiplier: float = 3.14159;
    var isReady: bool = true;
    var testChar: char = 'X';
    
    // Shadowing test with the ternary operator
    var baseValue: int = isReady ? (baseValue * 2) : 0;
    
    // Maximal munch testing (ensuring '>=' isn't read as '>' then '=')
    var conditionMet: bool = (baseValue >= 20) && (testChar != 'Y');
    
    // Control flow expression evaluating to the exit code
    if (conditionMet || !isReady) {
        0; 
    } else {
        1; 
    }
}