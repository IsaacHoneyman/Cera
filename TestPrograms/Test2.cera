/*
  Test 02: Primitives and Operators
  Validates bitwise math, structural equality, and tuple parsing.
*/

def entry(args: char list arr): int = {
    // Basic arithmetic and bitwise shifts
    var base: int = (10 + 5) * 2;
    var shifted: int = base << 2;
    var inverse: int = ~shifted;
    
    // Explicit tuples and structural equality testing
    var tup1: (int * float * bool) = (42, 3.14, true);
    var tup2 = (42, 3.14, true); // Type inferred
    
    var isEqual: bool = (tup1 == tup2) && (shifted != 0);
    
    // Arrays
    var flags: bool arr = arr[true, false, isEqual];
    
    if (isEqual) {
        0;
    } else {
        1;
    }
}