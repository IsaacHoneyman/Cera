#!/bin/bash

# 1. Resolve the absolute path of the Cera installation dynamically
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
CERA_ROOT="$(dirname "$SCRIPT_DIR")"
export CERA_LIB_PATH="$CERA_ROOT/lib"

COMMAND=$1
FILE=$2

print_help() {
    echo "Cera Compiler & Virtual Machine __VERSION__"
    echo "Usage: cera <command> [file] [args...]"
    echo ""
    echo "Commands:"
    echo "  version   Show the current Cera version"
    echo "  help      Show this help menu"
    echo "  build     Compile a .cera file to bytecode"
    echo "            Format: cera build <file.cera> [compiler_flags]"
    echo "  run       Execute a compiled bytecode file"
    echo "            Format: cera run [vm_flags] <file.cerabc> [program_args]"
    echo "  exec      Compile and execute a .cera file sequentially"
    echo "            Format: cera exec <file.cera>"
    echo "  clear     Clear all generated bytecode and dumps (Out/ directory)"
    echo ""
    echo "Compiler Flags (cerac):"
    echo "  -v, --verbose   Enable verbose logging"
    echo "  -t, --tokens    Dump lexer tokens"
    echo "  -a, --ast       Dump parser AST"
    echo "  -s, --analyzer  Dump semantic analyzer environment"
    echo "  -e, --emitter   Dump emitted bytecode"
    echo "  -d, --dump      Enable all dump flags"
    echo ""
    echo "Virtual Machine Flags (ceravm):"
    echo "  -d              Enable detailed VM logging"
    echo "  -f              Dump VM log to file"
    echo "  -s              Disable silent mode (show logs)"
}

print_version() {
    echo "Cera Compiler & Virtual Machine __VERSION__"
}

# Handle 'help' or empty commands
if [ -z "$COMMAND" ] || [ "$COMMAND" = "help" ]; then
    print_help
    exit 0
fi

# Handle 'version' command or version flags
if [ "$COMMAND" = "version" ]; then
    print_version
    exit 0
fi

# Handle 'clear' (removing the hardcoded Out/ directory)
if [ "$COMMAND" = "clear" ]; then
    echo "Clearing Cera output directories..."
    rm -rf Out/
    echo "Done."
    exit 0
fi

# All remaining commands require a target file
if [ -z "$FILE" ]; then
    echo "Error: Command '$COMMAND' requires a file argument."
    exit 1
fi

# Auto-append .cera for build and exec commands if the file doesn't exist
if [ "$COMMAND" = "build" ] || [ "$COMMAND" = "exec" ]; then
    if [ ! -f "$FILE" ] && [ -f "${FILE}.cera" ]; then
        FILE="${FILE}.cera"
    fi
fi

# Isolate the filename for pathing the bytecode output
FILENAME=$(basename "$FILE")
BASENAME="${FILENAME%.*}"
BYTECODE_FILE="Out/ByteCode/$BASENAME.cerabc"

case $COMMAND in
    build)
        # Shift past 'build' and pass the file and remaining args to cerac
        shift 2
        "$SCRIPT_DIR/cerac" "$FILE" "$@"
        ;;
    run)
        # Shift past 'run'
        shift 1
        
        # Rebuild the arguments array to inject extensions and Out/ByteCode path if necessary
        declare -a NEW_ARGS=()
        for arg in "$@"; do
            # If the arg isn't a flag
            if [[ "$arg" != -* ]]; then
                # Check local file + extension
                if [[ ! -f "$arg" ]] && [[ -f "${arg}.cerabc" ]]; then
                    arg="${arg}.cerabc"
                fi
                
                # Check Out/ByteCode path + extension
                if [[ ! -f "$arg" ]] && [[ -f "Out/ByteCode/$arg" ]]; then
                    arg="Out/ByteCode/$arg"
                elif [[ ! -f "$arg" ]] && [[ -f "Out/ByteCode/${arg}.cerabc" ]]; then
                    arg="Out/ByteCode/${arg}.cerabc"
                fi
            fi
            NEW_ARGS+=("$arg")
        done
        
        "$SCRIPT_DIR/ceravm" "${NEW_ARGS[@]}"
        ;;
    exec)
        # Build the source file
        "$SCRIPT_DIR/cerac" "$FILE"
        
        # If compilation succeeded (exit code 0), run the generated bytecode
        if [ $? -eq 0 ]; then
            if [ -f "$BYTECODE_FILE" ]; then
                "$SCRIPT_DIR/ceravm" "$BYTECODE_FILE"
            else
                echo "Error: Bytecode file $BYTECODE_FILE not found."
            fi
        fi
        ;;
    *)
        echo "Unknown command: $COMMAND"
        print_help
        exit 1
        ;;
esac